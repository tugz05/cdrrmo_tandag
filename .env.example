APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

# Mobile app — public download links on the Welcome page (optional)
MOBILE_APP_ANDROID_URL=
MOBILE_APP_IOS_URL=
MOBILE_APP_DIRECT_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Voice: staff heartbeat must pass before TwiML dials <Client> (default true).
# Set false for local Client-to-Client tests without /admin dashboard heartbeats.
# CALL_REQUIRE_STAFF_PRESENCE_FOR_VOICE_TWIML=false

# When the presence lookup fails (DB outage), the Twilio webhook can either fail closed (busy) or proceed.
# Local defaults to true; set explicitly in production if desired.
# CALL_PRESENCE_FAIL_OPEN=false

# When true, operator must have a fresh voice_client_ready_at (set by admin SPA / Flutter with twilio_voice_ready).
# Set false only if you rely on heartbeat-only (may allow 31603 if nobody registered Twilio.Device).
# CALL_REQUIRE_VOICE_CLIENT_READY=false

# Twilio Voice JS SDK edge (signaling). Leave empty for SDK default. Examples: singapore, sydney, ashburn.
# Must be valid — wrong value causes WebSocket/signaling issues (31005). Align with account region / JWT if needed.
# TWILIO_VOICE_SDK_EDGE=singapore

# Twilio Programmable Voice (Flutter + web). See docs/twilio-programmable-voice-verification.md
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...          # Required when TWILIO_VALIDATE_WEBHOOK_SIGNATURE=true (validate X-Twilio-Signature)
# TWILIO_API_KEY=SK...           # API Key SID (not Auth Token)
# TWILIO_API_SECRET=...          # Shown once when API key is created
# TWIML_APP_SID=AP...            # TwiML App used as VoiceGrant outgoingApplicationSid
# ADMIN_IDENTITY=1               # Fallback Twilio Client name when no voice-ready operators (numeric user id or string; sanitized)
# TWILIO_WEBHOOK_PUBLIC_ORIGIN=https://your-public-host  # Must match Voice URL host Twilio signs (no trailing slash)
# TWILIO_VOICE_HOME_REGION=      # e.g. us1, ie1 — optional for regional accounts
# TWILIO_VOICE_SDK_EDGE=        # e.g. singapore — optional Voice JS / mobile signaling edge
# TWILIO_VALIDATE_WEBHOOK_SIGNATURE=  # empty = auto: off in local/testing, on otherwise; or true/false

